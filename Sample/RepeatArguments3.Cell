import InputAndOutput.Console

Entrance Main()
{
	Program.Console<<Red<<"No Arguments!"<<End;
	Return 1;
};

Entrance Main(Count:Integer,Arguments:char*[])
{
	Program.Console<<"There are "<<Count<<"Arguments"<<End;
	For(Index:=0;Index<Count;Index++)
	{
		Program.Console<<"The "<<Index.ToIndexSimple()<<" Argument is "<<Arguments[Index]<<"."<<End;//Like "The 1st Argument is \"I'm stupid\"."
	};
	Return 0;
};